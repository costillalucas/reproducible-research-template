+def cargar_captura(dir_color, dir_oscuro, dir_flat, recorte):
+    """[PARCHE punto 5] Lee una captura con exposición por LED, organizada como
+    <dir_color>/<t>ms_recortada_<recorte>/filaR_colC.tiff (un tiempo t por LED), y devuelve por LED:
+      S    = (muestra - oscuro_t) / t          [cuentas/ms]
+      F    = (flat - oscuro_t) / t              (flat = misma captura sin muestra; None si no hay)
+      sat  = píxeles saturados (4095) en alguno de los cuadros crudos, si están; si no, en la organizada
+    El oscuro de cada t es cualquier archivo de <dir_oscuro>/<t>ms_recortada_<recorte>/."""
+    import glob, re
+    import tifffile
+    S, F, SAT = {}, {}, {}
+    for carpeta in sorted(glob.glob(os.path.join(dir_color, f"*ms_recortada_{recorte}"))):
+        t_ms = int(re.match(r"(\d+)ms", os.path.basename(carpeta)).group(1))
+        oscuro = tifffile.imread(sorted(glob.glob(os.path.join(dir_oscuro, os.path.basename(carpeta), "*.tiff")))[0]).astype(np.float64)
+        for path in sorted(Path(carpeta).glob("fila*.tiff")):
+            key = (int(path.stem[4:6]), int(path.stem[10:12]))       # mismo formato de etiqueta que antes
+            muestra = tifffile.imread(path).astype(np.float64)
+            S[key] = (muestra - oscuro) / t_ms
+            if dir_flat is not None:
+                F[key] = (tifffile.imread(os.path.join(dir_flat, os.path.basename(carpeta), path.name)).astype(np.float64) - oscuro) / t_ms
+            # cuadros crudos: <captura>/filaR_colC_color?/<t>ms/imagen_frame_*.tiff, recorte centrado
+            base = Path(dir_color).parents[1]
+            crudos = sorted(glob.glob(str(base / f"{path.stem}_color*" / f"{t_ms}ms" / "imagen_frame_*.tiff")))
+            if crudos:
+                sat = np.zeros(muestra.shape, bool)
+                for c in crudos:
+                    a = tifffile.imread(c)
+                    o0, o1 = (a.shape[0] - recorte) // 2, (a.shape[1] - recorte) // 2
+                    sat |= a[o0:o0 + recorte, o1:o1 + recorte] >= 4095
+            else:
+                sat = muestra >= 4095
+            SAT[key] = sat
+    return S, (F if dir_flat is not None else None), SAT
+
+
